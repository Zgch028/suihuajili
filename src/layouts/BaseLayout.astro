---
import '../styles/global.css';
import SeoMeta from '../components/SeoMeta.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  ogImage?: string;
}
const {
  title,
  description = SITE.description,
  keywords = [],
  ogType = 'website',
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 字体：标题思源宋体 / 正文思源黑体（国内可换成 fontsource 本地包） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@700&family=Inter&display=swap"
      rel="stylesheet"
    />
    <SeoMeta
      title={title}
      description={description}
      keywords={keywords}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
    />
    <!-- 百度搜索资源平台站点验证 -->
    <meta name="baidu-site-verification" content="codeva-sl6Vk5ldwE" />
  </head>
  <body>
    <slot />
  </body>
</html>
