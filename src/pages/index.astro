---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeriesCard from '../components/SeriesCard.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../data/site';

const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const posts = await getCollection('posts');
const allReadings = (await getCollection('reading')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime()
);
// 精选优先，不足 4 本再用其余补位，保证首页四本来自不同书架
const readings = [...allReadings.filter((r) => r.data.featured), ...allReadings.filter((r) => !r.data.featured)].slice(0, 4);
const works = (await getCollection('works'))
  .sort((a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 精选入口：按 slug 查「生肖系列总览篇」，挂在生肖系列卡片上直挂入口。
// 不写死路径字符串，改 slug 也不会失效；查不到则不显示（其余卡片零影响）。
const OVERVIEW_SLUG = 'shier-shengxiao-tonglan';
const overview = posts.find((p) => p.slug === OVERVIEW_SLUG);

const FEATURED: Record<string, { href: string; label: string }> =
  overview && overview.slug === OVERVIEW_SLUG
    ? {
        shiershengxiao: {
          href: `/posts/${overview.slug}`,
          label: '总览篇：你是哪一只？',
        },
      }
    : {};

// 系列卡片淡彩映射（对应设计稿低饱和底色）
const TINT: Record<string, string> = {
  dasongjili: 'var(--tint-1)',
  shiershengxiao: 'var(--tint-2)',
  ershisijieqi: 'var(--tint-3)',
  yisongyici: 'var(--tint-4)',
  jilishenghuoguan: 'var(--tint-5)',
  aixuexi: 'var(--tint-6)',
  shipinhao: 'var(--tint-7)',
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  alternateName: SITE.author.alternateName,
  jobTitle: SITE.author.jobTitle,
  url: SITE.url,
  sameAs: [
    `公众号:${SITE.author.officialAccount}`,
    `视频号:${SITE.author.videoAccount}`,
    `微信:${SITE.author.wechat}`,
  ],
};

// 站点级结构化数据：品牌搜索可展示「站内搜索框」富片段
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title={`${SITE.name} · 一份记录历史温情的笔记`}
  description="为今人做一份「纪丽」的生活提案，让历史照亮现代生活。岁华纪丽，记岁时之美好，存历史之温度。"
  keywords={['岁华纪丽', '宋文化', '大宋纪丽', '十二生肖职场人格', '二十四节气', '宋词', 'AI学习', '龙山大佛', '元一', '钻石监理']}
  ogImage="/og-default.png"
>
  <JsonLd data={personJsonLd} />
  <JsonLd data={websiteJsonLd} />
  <Nav active="首页" variant="full" />

  <div data-pagefind-body>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__eyebrow">岁华纪丽的文化基因</span>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__sub">
        一份记录历史温情的笔记。<br />
        为今人做一份“纪丽”的生活提案，让历史照亮现代生活。
      </p>
      <p class="hero__motto">岁华纪丽，记岁时之美好，存历史之温度。</p>
      <div class="hero__tags">
        <span class="tag">宋人生活美学</span>
        <span class="tag">十二生肖人格</span>
        <span class="tag">节气与读书笔记</span>
      </div>
      <div class="hero__btns">
        <a class="btn btn--primary" href="/about">开始了解我</a>
        <a class="btn btn--ghost" href="#series">浏览内容系列</a>
      </div>
    </div>
  </section>

  <!-- 读者能做什么 -->
  <section class="section section--paper">
    <div class="container">
      <span class="section__eyebrow">WHAT YOU CAN DO</span>
      <h2 class="section__title">在这里你能做什么</h2>
      <div class="cv-row">
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--navy)">壹</div>
          <h3>按系列读</h3>
          <p>大宋纪丽、十二生肖、二十四节气、宋词……每个系列一条线，读完一篇接着读下一篇。</p>
        </div>
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--brand-red)">贰</div>
          <h3>翻开就读</h3>
          <p>{allReadings.length} 本 AI 辅助精读笔记，分作六个书架。随手抽一本，把一本书拆成能拿来用的认知框架。</p>
        </div>
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--ink-soft)">叁</div>
          <h3>点开就玩</h3>
          <p>明堂图、太阳系、长征交互地图，都是能在浏览器里直接上手的小作品，不用下载、不用安装。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 内容系列 -->
  <section class="section" id="series">
    <div class="container">
      <span class="section__eyebrow">CONTENT SERIES</span>
      <h2 class="section__title">内容系列</h2>
      <p class="section__sub">按系列分类，每个系列独立页面，方便搜索引擎抓取与长尾引流。</p>
      <div class="series-grid">
        {
          series.map((s) => (
            <SeriesCard
              title={s.data.title}
              tag={s.data.tag}
              description={s.data.description}
              href={`/series/${s.slug}`}
              tint={TINT[s.slug] ?? 'var(--tint-1)'}
              featured={FEATURED[s.slug]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 读书笔记 -->
  <section class="section section--paper" id="reading">
    <div class="container">
      <span class="section__eyebrow">READING NOTES</span>
      <h2 class="section__title">读书笔记</h2>
      <p class="section__sub">用 AI 把一本书拆成可复用的认知框架。</p>
      <div class="book-row">
        {
          readings.map((r) => (
            <a class="book-card" href={`/reading/${r.slug}`}>
              <div class="book-card__spine">
                <span class="book-card__title">{r.data.title}</span>
                <span class="book-card__author">{r.data.author}</span>
              </div>
              <div class="book-card__body">
                {r.data.edition && <span class="book-card__edition">{r.data.edition}</span>}
                <p>{r.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
      <a class="section__more" href="/reading">进入书架 →</a>
    </div>
  </section>

  <!-- 作品工作室 -->
  <section class="section" id="works">
    <div class="container">
      <span class="section__eyebrow">WORKS STUDIO</span>
      <h2 class="section__title">作品工作室</h2>
      <p class="section__sub">用 AI 做的小东西，点开就能用。</p>
      <div class="work-row">
        {
          works.map((w) => (
            <a class="work-card" href={`/works/${w.slug}`}>
              <div class="work-card__cover">
                {w.data.cover ? (
                  <img src={w.data.cover} alt={w.data.title} />
                ) : (
                  <span>{w.data.title.slice(0, 2)}</span>
                )}
              </div>
              <div class="work-card__body">
                <span class="work-card__tag">{w.data.tags[0] ?? '作品'}</span>
                <h3>{w.data.title}</h3>
                <p>{w.data.description}</p>
                <span class="work-card__cta">打开体验 →</span>
              </div>
            </a>
          ))
        }
      </div>
      <a class="section__more" href="/works">进入工作室 →</a>
    </div>
  </section>

  <!-- 站内搜索 + AI Agent 认证入口 -->
  <section class="section agent-section" data-pagefind-ignore>
    <div class="container">
      <span class="section__eyebrow" style="color:var(--gold)">SEARCH & AI-AGENT READY</span>
      <h2 class="section__title" style="color:#fff">站内搜索</h2>
      <p class="section__sub" style="color:#c9c4ba">
        读者用搜索快速找到内容；AI Agent 用结构化数据快速提取你的认证信息——这是平台账号给不了的资产。
      </p>
      <form class="search-bar" action="/search" method="get">
        <input
          class="search-bar__input"
          type="text"
          name="q"
          placeholder="输入关键词，例如「大宋纪丽」「职场人格」「宋词」…"
        />
        <button class="btn btn--primary btn--sm" type="submit">搜索</button>
      </form>
      <p class="search-note">也可以直接问 AI：站内内容由 AI 帮你找。</p>
    </div>
  </section>

  <!-- 关于我 Teaser -->
  <section class="section section--paper">
    <div class="container">
      <span class="section__eyebrow">ABOUT ME</span>
      <h2 class="section__title">三分钟，认识岁华纪丽</h2>
      <div class="about-row">
        <img class="about-avatar" src="/avatar.jpg" alt="岁华纪丽头像" />
        <div class="about-text">
          <p class="about-bio">{SITE.author.bio}</p>
          <div class="about-matrix">
            {SITE.matrix.map((m) => <span class="chip">{m.label}</span>)}
          </div>
          <a class="btn btn--primary btn--sm" href="/about">查看完整关于页 →</a>
        </div>
      </div>
    </div>
  </section>

  </div>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: var(--navy) url('/hero-bg.jpg') center / cover no-repeat;
    padding: 110px 0 96px;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 24, 45, 0.62) 0%,
      rgba(16, 24, 45, 0.55) 40%,
      rgba(16, 24, 45, 0.72) 100%
    );
    z-index: -1;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--gold);
  }
  .hero__title {
    font-family: var(--font-serif);
    font-size: 80px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -2px;
    line-height: 1.05;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .hero__sub {
    font-size: 18px;
    color: #f2efe6;
    max-width: 680px;
    line-height: 1.8;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }
  .hero__motto {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--gold);
    letter-spacing: 2px;
    margin-top: -6px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  .hero__tags {
    position: relative;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
  .tag {
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .hero__btns {
    display: flex;
    gap: 16px;
    margin-top: 14px;
  }
  .cv-row {
    display: flex;
    gap: 24px;
    margin-top: 32px;
  }
  .cv-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
  }
  .cv-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 700;
  }
  .cv-card h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
  }
  .cv-card p {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .series-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
  }
  .agent-section {
    background: var(--navy);
  }
  .search-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 24px;
    background: #fff;
    border-radius: var(--radius-sm);
    padding: 10px 16px;
  }
  .search-bar__input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--ink);
  }
  .search-bar__input::placeholder {
    color: var(--muted);
  }
  .search-note {
    margin-top: 16px;
    font-size: 14px;
    color: #c9c4ba;
  }
  .about-row {
    display: flex;
    gap: 32px;
    align-items: center;
    margin-top: 32px;
  }
  .about-avatar {
    width: 160px;
    height: 160px;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid var(--gold);
    background: var(--tint-4);
    flex-shrink: 0;
  }
  .about-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .about-bio {
    font-size: 16px;
    color: var(--ink);
    line-height: 1.7;
  }
  .about-matrix {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  /* 读书笔记 · 书架卡片 */
  .book-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 28px;
  }
  .book-card {
    display: flex;
    flex-direction: column;
    background: #fffdf8;
    border: 1px solid rgba(120, 100, 70, 0.2);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .book-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(80, 60, 30, 0.13);
  }
  .book-card__spine {
    background: linear-gradient(180deg, #8a6a2e, #6d5222);
    color: #f7f0e2;
    padding: 22px 18px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .book-card__title {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 1.5px;
    line-height: 1.35;
  }
  .book-card__author {
    font-size: 12px;
    opacity: 0.82;
  }
  .book-card__body {
    padding: 14px 16px 18px;
  }
  .book-card__edition {
    display: inline-block;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(154, 123, 46, 0.14);
    color: var(--gold);
    font-weight: 600;
  }
  .book-card__body p {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 8px 0 0;
  }
  /* 作品工作室 · 橱窗卡片 */
  .work-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 28px;
  }
  .work-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .work-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(10, 21, 48, 0.12);
  }
  .work-card__cover {
    aspect-ratio: 3 / 2;
    height: auto;
    background: linear-gradient(135deg, var(--navy), #2b3a5e);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 34px;
    overflow: hidden;
  }
  .work-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .work-card__body {
    padding: 18px 20px 22px;
  }
  .work-card__tag {
    font-size: 12px;
    font-weight: 600;
    color: var(--gold);
  }
  .work-card__body h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 6px 0 8px;
    line-height: 1.4;
  }
  .work-card__body p {
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .work-card__cta {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-red);
  }
  .section__more {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-red);
    text-decoration: none;
  }
  @media (max-width: 768px) {
    .book-row,
    .work-row {
      grid-template-columns: 1fr 1fr;
    }
    .hero__title {
      font-size: 48px;
    }
    .cv-row {
      flex-direction: column;
    }
    .about-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
