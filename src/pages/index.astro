---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeriesCard from '../components/SeriesCard.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../data/site';

const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);

// 系列卡片淡彩映射（对应设计稿低饱和底色）
const TINT: Record<string, string> = {
  dasongjili: 'var(--tint-1)',
  shiershengxiao: 'var(--tint-2)',
  ershisijieqi: 'var(--tint-3)',
  yisongyici: 'var(--tint-4)',
  jilishenghuoguan: 'var(--tint-5)',
  aixuexi: 'var(--tint-6)',
  shipinhao: 'var(--tint-7)',
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  alternateName: SITE.author.alternateName,
  jobTitle: SITE.author.jobTitle,
  url: SITE.url,
  sameAs: [
    `公众号:${SITE.author.officialAccount}`,
    `视频号:${SITE.author.videoAccount}`,
    `微信:${SITE.author.wechat}`,
  ],
};

// 站点级结构化数据：品牌搜索可展示「站内搜索框」富片段
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title={`${SITE.name} · 一份记录历史温情的笔记`}
  description="为今人做一份「纪丽」的生活提案，让历史照亮现代生活。岁华纪丽，记岁时之美好，存历史之温度。"
  keywords={['岁华纪丽', '宋文化', '大宋纪丽', '十二生肖职场人格', '二十四节气', '宋词', 'AI学习', '龙山大佛', '元一', '钻石监理']}
  ogImage="/og-default.png"
>
  <JsonLd data={personJsonLd} />
  <JsonLd data={websiteJsonLd} />
  <Nav active="首页" variant="full" />

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="hero__eyebrow">岁华纪丽的文化基因</span>
      <h1 class="hero__title">{SITE.name}</h1>
      <p class="hero__sub">
        一份记录历史温情的笔记。<br />
        为今人做一份“纪丽”的生活提案，让历史照亮现代生活。
      </p>
      <p class="hero__motto">岁华纪丽，记岁时之美好，存历史之温度。</p>
      <div class="hero__tags">
        <span class="tag">数字资产</span>
        <span class="tag">搜索引擎引流</span>
        <span class="tag">完整个人名片</span>
      </div>
      <div class="hero__btns">
        <a class="btn btn--primary" href="/about">开始了解我</a>
        <a class="btn btn--ghost" href="#series">浏览内容系列</a>
      </div>
    </div>
  </section>

  <!-- 三个核心价值 -->
  <section class="section section--paper">
    <div class="container">
      <span class="section__eyebrow">WHY IT MATTERS</span>
      <h2 class="section__title">三个核心价值</h2>
      <div class="cv-row">
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--navy)">壹</div>
          <h3>数字资产</h3>
          <p>域名是你的，内容是你的，流量是你的。平台规则怎么变，你的阵地都在。</p>
        </div>
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--brand-red)">贰</div>
          <h3>搜索引擎引流</h3>
          <p>你的「大宋纪丽」「十二生肖职场人格解码」等内容，有人搜的时候能搜到你。长尾流量持续带来新读者。</p>
        </div>
        <div class="cv-card">
          <div class="cv-card__icon" style="background:var(--ink-soft)">叁</div>
          <h3>完整个人名片</h3>
          <p>公众号、视频号、微信号、AI 学习内容，全部聚合在一个地方。三分钟知道你是谁、你能提供什么价值。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 内容系列 -->
  <section class="section" id="series">
    <div class="container">
      <span class="section__eyebrow">CONTENT SERIES</span>
      <h2 class="section__title">内容系列</h2>
      <p class="section__sub">按系列分类，每个系列独立页面，方便搜索引擎抓取与长尾引流。</p>
      <div class="series-grid">
        {
          series.map((s) => (
            <SeriesCard
              title={s.data.title}
              tag={s.data.tag}
              description={s.data.description}
              href={`/series/${s.slug}`}
              tint={TINT[s.slug] ?? 'var(--tint-1)'}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 站内搜索 + AI Agent 认证入口 -->
  <section class="section agent-section">
    <div class="container">
      <span class="section__eyebrow" style="color:var(--gold)">SEARCH & AI-AGENT READY</span>
      <h2 class="section__title" style="color:#fff">站内搜索 + AI Agent 认证入口</h2>
      <p class="section__sub" style="color:#c9c4ba">
        读者用搜索快速找到内容；AI Agent 用结构化数据快速提取你的认证信息——这是平台账号给不了的资产。
      </p>
      <form class="search-bar" action="/search" method="get">
        <input
          class="search-bar__input"
          type="text"
          name="q"
          placeholder="输入关键词，例如「大宋纪丽」「职场人格」「宋词」…"
        />
        <button class="btn btn--primary btn--sm" type="submit">搜索</button>
      </form>
      <div class="agent-feats">
        <span>· 每个内容块后附机器可读结构化标签</span>
        <span>· 个人介绍 / 职业背景均带 JSON-LD</span>
        <span>· 方便各类 AI Agent 检索与提取</span>
      </div>
      <div class="agent-card">
        <span class="agent-card__label">AI Agent 认证标准入口 · /agent.json</span>
        <pre class="agent-card__code">{JSON.stringify(personJsonLd, null, 2)}</pre>
      </div>
    </div>
  </section>

  <!-- 关于我 Teaser -->
  <section class="section section--paper">
    <div class="container">
      <span class="section__eyebrow">ABOUT ME</span>
      <h2 class="section__title">三分钟，认识岁华纪丽</h2>
      <div class="about-row">
        <img class="about-avatar" src="/avatar.jpg" alt="岁华纪丽头像" />
        <div class="about-text">
          <p class="about-bio">{SITE.author.bio}</p>
          <div class="about-matrix">
            {SITE.matrix.map((m) => <span class="chip">{m.label}</span>)}
          </div>
          <a class="btn btn--primary btn--sm" href="/about">查看完整关于页 →</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: var(--navy) url('/hero-bg.jpg') center / cover no-repeat;
    padding: 110px 0 96px;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 24, 45, 0.62) 0%,
      rgba(16, 24, 45, 0.55) 40%,
      rgba(16, 24, 45, 0.72) 100%
    );
    z-index: -1;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--gold);
  }
  .hero__title {
    font-family: var(--font-serif);
    font-size: 80px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -2px;
    line-height: 1.05;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .hero__sub {
    font-size: 18px;
    color: #f2efe6;
    max-width: 680px;
    line-height: 1.8;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }
  .hero__motto {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--gold);
    letter-spacing: 2px;
    margin-top: -6px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  .hero__tags {
    position: relative;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }
  .tag {
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .hero__btns {
    display: flex;
    gap: 16px;
    margin-top: 14px;
  }
  .cv-row {
    display: flex;
    gap: 24px;
    margin-top: 32px;
  }
  .cv-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
  }
  .cv-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 700;
  }
  .cv-card h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
  }
  .cv-card p {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .series-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
  }
  .agent-section {
    background: var(--navy);
  }
  .search-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 24px;
    background: #fff;
    border-radius: var(--radius-sm);
    padding: 10px 16px;
  }
  .search-bar__input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--ink);
  }
  .search-bar__input::placeholder {
    color: var(--muted);
  }
  .agent-feats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 16px;
    font-size: 14px;
    color: #c9c4ba;
  }
  .agent-card {
    margin-top: 20px;
    background: var(--navy-deep);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    padding: 24px;
  }
  .agent-card__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--gold);
  }
  .agent-card__code {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    color: #9fe6b0;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .about-row {
    display: flex;
    gap: 32px;
    align-items: center;
    margin-top: 32px;
  }
  .about-avatar {
    width: 160px;
    height: 160px;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid var(--gold);
    background: var(--tint-4);
    flex-shrink: 0;
  }
  .about-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .about-bio {
    font-size: 16px;
    color: var(--ink);
    line-height: 1.7;
  }
  .about-matrix {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .hero__title {
      font-size: 48px;
    }
    .cv-row {
      flex-direction: column;
    }
    .about-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
