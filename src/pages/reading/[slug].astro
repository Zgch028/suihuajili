---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../data/site';

export const getStaticPaths = (async () => {
  // iframe 内的正文 Pagefind 抓不到：构建时从原版 HTML 抽一份纯文本，供外侧摘要区索引。
  // 原 HTML 的显示方式完全不变，这里只读取文件，不改写任何原稿。
  const extractNoteText = (htmlPath: string): string => {
    const file = path.join(process.cwd(), 'public', htmlPath.replace(/^\//, ''));
    if (!fs.existsSync(file)) return '';
    const html = fs.readFileSync(file, 'utf8');
    const main = html.match(/<main\b[^>]*>([\s\S]*?)<\/main>/i)?.[1] ?? html;
    return main
      .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '')
      .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 900);
  };

  const notes = await getCollection('reading');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note, excerpt: extractNoteText(note.data.htmlPath) },
  }));
}) satisfies GetStaticPaths;

const { note, excerpt } = Astro.props;
const noteMeta = `读书笔记 · ${note.data.category} · ${note.data.edition ?? '完整版'}`;

// 读书笔记是作者撰写的解读文章，不是原书本身；用 ScholarlyArticle 标注，避免著作权误标
const noteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: note.data.title,
  datePublished: note.data.date.toISOString(),
  description: note.data.description,
  author: { '@type': 'Person', name: SITE.author.name },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(`/reading/${note.slug}`, SITE.url).href,
  keywords: [...note.data.tags, note.data.author].join(', '),
};
---

<BaseLayout
  title={`${note.data.title}｜读书笔记｜${SITE.name}`}
  description={note.data.description}
  keywords={note.data.tags}
>
  <JsonLd data={noteJsonLd} />
  <span data-pagefind-meta={`subtitle:${noteMeta}`} data-pagefind-ignore hidden></span>
  <Nav active="读书笔记" variant="minimal" />

  <section class="note-head">
    <div class="container">
      <a class="note-head__crumb" href="/reading" data-pagefind-ignore>← 返回书架</a>
      <h1 data-pagefind-meta="title">{note.data.title}</h1>
      <p class="note-head__meta">
        {note.data.author}{note.data.edition ? ` · ${note.data.edition}` : ''}
      </p>
    </div>
  </section>

  <section class="note-frame">
    <iframe
      src={note.data.htmlPath}
      title={note.data.title}
      loading="lazy"
    ></iframe>
  </section>

  <!-- 供 Pagefind 索引的可检索正文摘要：iframe 显示方式不变，这里只是外侧的静态文本副本 -->
  <section class="note-search-text" data-pagefind-body>
    <div class="container">
      <h2 class="note-search-text__title">{note.data.title}</h2>
      <p class="note-search-text__meta">
        {note.data.author} · {note.data.edition ?? '完整版'} · {note.data.tags.join(' / ')}
      </p>
      <p class="note-search-text__body">{excerpt || note.data.description}</p>
    </div>
  </section>

  <section class="note-foot">
    <div class="container">
      <a class="btn btn--primary btn--sm" href="/reading" data-pagefind-ignore>← 返回书架</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .note-head {
    background: linear-gradient(135deg, #f7f0e2, #efe6d2);
    padding: 36px 0 28px;
    border-bottom: 1px solid var(--border);
  }
  .note-head__crumb {
    font-size: 14px;
    color: var(--gold);
    text-decoration: none;
  }
  .note-head h1 {
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    margin: 12px 0 6px;
  }
  .note-head__meta {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0;
  }
  .note-frame {
    background: #efe6d2;
    padding: 18px;
  }
  .note-frame iframe {
    display: block;
    width: 100%;
    height: calc(100vh - 150px);
    min-height: 700px;
    border: 0;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 30px rgba(80, 60, 30, 0.12);
  }
  /* 可检索正文摘要：低调排版，不改变上方 iframe 的显示方式 */
  .note-search-text {
    padding: 28px 0 10px;
    background: #fdfaf2;
    border-top: 1px solid var(--border);
  }
  .note-search-text__title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .note-search-text__meta {
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 0.3px;
    margin: 0 0 12px;
  }
  .note-search-text__body {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.85;
    margin: 0;
  }
  .note-foot {
    padding: 28px 0 48px;
    background: #efe6d2;
  }
  @media (max-width: 640px) {
    .note-head h1 {
      font-size: 28px;
    }
    .note-frame {
      padding: 8px;
    }
    .note-frame iframe {
      height: 82vh;
      min-height: 560px;
      border-radius: 8px;
    }
  }
</style>
