---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../data/site';

export const getStaticPaths = (async () => {
  const series = await getCollection('series');
  const posts = await getCollection('posts');
  return series.map((s) => ({
    params: { slug: s.slug },
    props: {
      series: s,
      posts: posts
        .filter((p) => p.data.series === s.slug)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}) satisfies GetStaticPaths;

const { series, posts } = Astro.props;

// 置顶横幅：部分系列有「总览/通览」性质的篇目，提到列表最上方，避免淹没在几十篇平铺里。
// 与首页精选入口同一套约定（按 slug 查、查不到就不显示），标题下方的正文里也会推荐它。
const PINNED: Record<string, string> = {
  shiershengxiao: 'shier-shengxiao-tonglan',
};
const pinnedId = PINNED[series.slug];
const pinned = pinnedId ? posts.find((p) => p.slug === pinnedId) : undefined;
// 置顶后从常规列表里移除，避免同一篇出现两次
const listPosts = pinned ? posts.filter((p) => p.slug !== pinned.slug) : posts;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: series.data.title,
  description: series.data.seoDescription,
  url: new URL(`/series/${series.slug}`, SITE.url).href,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---

<BaseLayout
  title={series.data.seoTitle}
  description={series.data.seoDescription}
  keywords={series.data.seoKeywords}
>
  <JsonLd data={collectionJsonLd} />
  <Nav active={series.data.title} variant="minimal" />

  <section class={`series-header ${series.data.headerImage ? 'series-header--with-bg' : ''}`} style={series.data.headerImage ? `background-image: url('${series.data.headerImage}');` : undefined}>
    <div class="container">
      <span class="series-header__eyebrow">{series.data.eyebrow}</span>
      <h1 class="series-header__title">{series.data.title}</h1>
      <p class="series-header__sub">{series.data.description}</p>
      <div class="seo-panel">
        <span class="seo-panel__label">本页 SEO 元信息（搜索引擎可见）</span>
        <div>title：{series.data.seoTitle}</div>
        <div>description：{series.data.seoDescription}</div>
        <div>keywords：{series.data.seoKeywords.join(', ')}</div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      {
        pinned && (
          <a class="series-pinned" href={`/posts/${pinned.slug}`}>
            <span class="series-pinned__badge">全系列总览 · 置顶推荐</span>
            <span class="series-pinned__title">{pinned.data.title}</span>
            <span class="series-pinned__desc">{pinned.data.description}</span>
            <span class="series-pinned__link">从这篇开始读 →</span>
          </a>
        )
      }
      <div class="post-list">
        {
          listPosts.length > 0 ? (
            series.slug === 'shipinhao' ? (
              listPosts.map((p) => (
                <VideoCard
                  title={p.data.title}
                  description={p.data.description}
                  date={p.data.date}
                  cover={p.data.cover}
                  video={p.data.video}
                  href={p.data.video && p.data.video.startsWith('http') ? p.data.video : `/posts/${p.slug}`}
                />
              ))
            ) : (
              listPosts.map((p) => (
                <ArticleCard
                  title={p.data.title}
                  description={p.data.description}
                  date={p.data.date}
                  volume={p.data.volume}
                  cover={p.data.cover}
                  href={`/posts/${p.slug}`}
                />
              ))
            )
          ) : (
            <p class="post-empty">该系列文章正在精选整理中，敬请期待。</p>
          )
        }
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .series-header {
    background: var(--navy);
    padding: 64px 0 48px;
    position: relative;
  }
  .series-header--with-bg {
    background-color: var(--navy);
    background-size: cover;
    background-position: center;
  }
  .series-header--with-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    /* 宣纸亮调遮罩：左侧暖米色保证墨字清晰，右侧渐淡透出画意 */
    background: linear-gradient(
      90deg,
      rgba(247, 240, 226, 0.94) 0%,
      rgba(247, 240, 226, 0.78) 42%,
      rgba(247, 240, 226, 0.30) 100%
    );
    z-index: 1;
  }
  .series-header > .container {
    position: relative;
    z-index: 2;
  }
  .series-header__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--gold);
  }
  .series-header__title {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -1px;
    margin-top: 8px;
  }
  .series-header__sub {
    font-size: 16px;
    color: #c9c4ba;
    line-height: 1.6;
    margin-top: 16px;
    max-width: 720px;
  }
  .seo-panel {
    margin-top: 24px;
    background: var(--navy-deep);
    border-radius: var(--radius);
    padding: 20px;
    font-size: 13px;
    color: #c9c4ba;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .seo-panel__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--gold);
  }

  /* 仅当配了 headerImage 时启用宣纸亮调配色 */
  .series-header--with-bg .series-header__eyebrow {
    color: #9a7b2e;
  }
  .series-header--with-bg .series-header__title {
    color: #2a241c;
  }
  .series-header--with-bg .series-header__sub {
    color: #5b5346;
  }
  .series-header--with-bg .seo-panel {
    background: rgba(255, 252, 246, 0.74);
    border: 1px solid rgba(120, 100, 70, 0.18);
    color: #5b5346;
  }
  .series-header--with-bg .seo-panel__label {
    color: #9a7b2e;
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 置顶横幅：系列总览/通览篇的入口，深蓝底金字，与下方纸纹列表拉开层次 */
  .series-pinned {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
    padding: 24px 28px;
    background: var(--navy);
    border: 1px solid var(--navy-deep);
    border-left: 4px solid var(--gold);
    border-radius: var(--radius);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .series-pinned:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(10, 21, 48, 0.16);
  }
  .series-pinned__badge {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(201, 168, 106, 0.16);
    color: var(--gold);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
  }
  .series-pinned__title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
    color: #fff;
  }
  .series-pinned__desc {
    font-size: 14px;
    line-height: 1.65;
    color: #c9c4ba;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .series-pinned__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--gold);
  }
  @media (max-width: 768px) {
    .series-pinned {
      padding: 20px;
    }
    .series-pinned__title {
      font-size: 19px;
    }
  }

  .post-empty {
    color: var(--ink-soft);
    font-size: 15px;
  }
</style>
